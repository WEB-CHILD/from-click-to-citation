# Raw participant navigation histories (contain real names / private data)
navigation_histories/

# Maps real filenames (participant names) to anonymised IDs
participant_map.json

# Rendered per-participant Markdown histories (derived from private data)
output/markdown/
output/repeat_runs/

# SolrWayback server logs (IPs, full URLs)
logs/

# Corrected copy of the raw histories (contain real names / private data)
navigation_histories_corrected/

# Maps the pseudonyms in anonymised/ back to the real hosts, paths and search terms
anonymisation_key.json

# Contains the real archive address
correct_histories.py

# The anonymised dataset (only code is kept in git)
anonymised/

# Python bytecode (a compiled correct_histories would expose the archive address)
__pycache__/

# macOS Finder settings
.DS_Store
